# ======== Database ========
# Full Postgres connection string (Neon, local, or RDS)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:password@localhost:5432/apptrack

# ======== Auth ========
JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRES_IN=7d

# ======== Server ========
PORT=3000
NODE_ENV=development

# ======== AWS S3 (resume storage) ========
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=apptrack-resumes

# ======== CORS ========
CORS_ORIGIN=http://localhost:5173

# ======== Pipeline Service URLs ========
# Internal URLs for each Python agent service
SEARCH_SERVICE_URL=http://localhost:8001
DRAFT_SERVICE_URL=http://localhost:8002
SUBMISSION_SERVICE_URL=http://localhost:8003

# ======== Service-to-service auth ========
# Shared secret used by Python agents to authenticate against /api/pipeline/* endpoints
# Generate with: openssl rand -hex 32
SERVICE_API_KEY=replace-with-long-random-secret

# ======== App URLs (used in approval email links) ========
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3000

# ======== Gmail OAuth2 (approval email dispatch) ========
# See docs/GMAIL_OAUTH_SETUP.md for instructions on obtaining these credentials
GMAIL_FROM_ADDRESS=your-email@gmail.com
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
